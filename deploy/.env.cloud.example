# Environment variables read by deploy/docker-compose.cloud.yml on the
# Oracle VM. Copy this to a real ".env" file in the project root on the
# SERVER ONLY — never commit the real file, never copy your local dev .env
# here as-is.
#
#   cp deploy/.env.cloud.example .env
#   nano .env      # fill in real values below

# A strong, freshly-generated Postgres password for the cloud database.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The public hostname this test environment will be reached at.
HM_DOMAIN=test.hirometrics.com

# Hash for the shared basic-auth password guarding the whole site (username
# is "hmtester", set directly in deploy/Caddyfile since it isn't sensitive).
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-chosen-password'
CADDY_BASIC_AUTH_HASH=

# ---------------------------------------------------------------------------
# backend/.env on the server ALSO needs its own values (copied from
# backend/.env.example, not from your local backend/.env):
#   - SECRET_KEY              -> generate fresh: openssl rand -hex 32
#   - SSN_ENCRYPTION_KEY      -> generate fresh: openssl rand -hex 32
#   - DATABASE_URL / REDIS_URL are overridden automatically by the cloud
#     compose file above, so whatever is in backend/.env for those is fine.
#   - Leave MAIL_ENABLED=false and AWS_* blank unless you intend to send
#     real email or use S3 from the test box.
#
# IMPORTANT: this is a test/demo environment. Seed it with synthetic
# candidate data, not real candidates' SSNs, resumes, or photos.
# ---------------------------------------------------------------------------
