# Caddy config for the HiroMetrics internal test environment.
# Replace test.hirometrics.com with your actual test subdomain before deploying.
#
# The basicauth block puts a username/password wall in front of requests
# that do not already carry the app's own Bearer token -- this is an
# internal test box on the open internet, not a public release, so casual
# visitors and search engines should not be able to reach it at all.
#
# The password hash itself is NOT stored here -- it comes from the
# CADDY_BASIC_AUTH_HASH environment variable (set in the server-only .env
# file, never committed) so no credential material lives in git history.
# Generate a hash on the server with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-chosen-password'
# then put it in .env as CADDY_BASIC_AUTH_HASH=<that output>.

test.hirometrics.com {
	# Requests already carrying a Bearer token are authenticated at the
	# app level (they had to pass through the login endpoint, which itself
	# sits behind this same basic-auth wall, to get that token) -- so only
	# gate requests WITHOUT one. This avoids a header collision: the app's
	# own "Authorization: Bearer ..." would otherwise overwrite whatever
	# Basic credential the browser attached, and get rejected by Caddy.
	@needs_basic_auth {
		not header Authorization "Bearer*"
	}
	basicauth @needs_basic_auth {
		hmtester {$CADDY_BASIC_AUTH_HASH}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:5173
	}
}
