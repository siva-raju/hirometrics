# Caddy config for the HiroMetrics internal test environment.
# Replace test.hirometrics.com with your actual test subdomain before deploying.
#
# The basicauth block puts a username/password wall in front of the ENTIRE
# app (frontend + API) — this is an internal test box on the open internet,
# not a public release, so nothing should be reachable without it.
#
# The password hash itself is NOT stored here -- it comes from the
# CADDY_BASIC_AUTH_HASH environment variable (set in the server-only .env
# file, never committed) so no credential material lives in git history.
# Generate a hash on the server with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-chosen-password'
# then put it in .env as CADDY_BASIC_AUTH_HASH=<that output>.

test.hirometrics.com {
	basicauth /* {
		hmtester {$CADDY_BASIC_AUTH_HASH}
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:5173
	}
}
