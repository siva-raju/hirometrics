# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=HiroMetrics
APP_ENV=development
SECRET_KEY=change-this-to-a-random-32-char-string-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:5173
HM_DOMAIN=hirometrics.com

# ── Database ───────────────────────────────────────────────────────────────────
# Local development (matches docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/hirometrics

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Set MAIL_ENABLED=true and fill credentials to send real emails
MAIL_ENABLED=false
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@hirometrics.com
MAIL_CC_MONITOR=cc.hm.monitor@hirometrics.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ── AWS S3 (file uploads) ──────────────────────────────────────────────────────
# Leave blank to use local storage placeholder in development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=hirometrics-documents

# ── Encryption ─────────────────────────────────────────────────────────────────
# AES-256 key for SSN encryption — generate with: openssl rand -hex 32
SSN_ENCRYPTION_KEY=change-this-to-a-real-32-byte-key
